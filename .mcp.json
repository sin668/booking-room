{
  "mcpServers": {
    "code-review-graph": {
      "command": "uvx",
      "args": [
        "code-review-graph",
        "serve"
      ],
      "type": "stdio"
    },
    "graphify": {
      "command": "graphify",
      "args": [
        "--mcp",
        "."
      ],
      "type": "stdio",
      "disabled": true
    }
  }
}