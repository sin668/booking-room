# =============================================================================
# Booking Room Server - Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/booking_room

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (生成密钥: openssl rand -hex 32)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Aliyun SMS
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=去K书
ALIYUN_SMS_TEMPLATE_CODE=SMS_504980114
ALIYUN_CAPTCHA_SCENE_ID=

# Admin
ADMIN_TOKEN=
# 管理端会话有效期（天），独立于共用的 ACCESS_TOKEN_EXPIRE_MINUTES，仅作用于管理端 JWT
ADMIN_ACCESS_TOKEN_EXPIRE_DAYS=7

# Booking verification
# Public H5 base URL used in QR code verify_url, e.g. https://booking.example.com
FRONTEND_BASE_URL=
BOOKING_TIMEZONE=Asia/Shanghai
BOOKING_CLEANUP_INTERVAL_SECONDS=60
SCHEDULE_STATUS_CHECK_TIME=00:00

# WeChat Pay
# Keep disabled for local development unless all merchant settings are provided.
WECHAT_PAY_ENABLED=false
WECHAT_PAY_APPID=
WECHAT_PAY_MCHID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_PLATFORM_CERT_SERIAL_NO=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_BOOKING_NOTIFY_URL=
WECHAT_PAY_API_BASE_URL=https://api.mch.weixin.qq.com

# WeChat mini program login
# Keep disabled for local development unless AppID and Secret are provided.
WECHAT_MINI_LOGIN_ENABLED=false
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=
WECHAT_MINI_API_BASE_URL=https://api.weixin.qq.com
WECHAT_MINI_REQUEST_TIMEOUT_SECONDS=5

# Cookie (生产环境设为 true)
COOKIE_SECURE=false

# Upload storage
# Use local for development or rollback. Use oss in production.
UPLOAD_STORAGE_DRIVER=local
OSS_ENDPOINT=
OSS_BUCKET_NAME=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Use a public OSS endpoint outside Aliyun VPC, e.g. https://oss-cn-shenzhen.aliyuncs.com.
# Internal endpoints such as *-internal.aliyuncs.com only work from the same Aliyun VPC.
# Production should use a CDN/custom public domain with scheme, e.g. https://cdn.example.com.
OSS_PUBLIC_BASE_URL=

# Feature flags
REGISTRATION_ENABLED=true
